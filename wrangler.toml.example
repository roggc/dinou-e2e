#:schema node_modules/wrangler/config-schema.json
name = "dinou-cloudflare-app"
main = ".dinou/cloudflare/worker.js"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

# ====================================================================
# Cloudflare Workers Static Assets
# ====================================================================
# Serves public/* files and client JS/CSS bundles from .dinou/cloudflare/assets
# while keeping internal SSG/ISR/PPR cache isolated under __dinou_dist2/.
[assets]
directory = ".dinou/cloudflare/assets"
binding = "ASSETS"
run_worker_first = true
html_handling = "none"

# ====================================================================
# Incremental Static Regeneration (ISR / ISG) Cache
# ====================================================================
# Un-comment to enable edge-cached pages across all Cloudflare POPs
# [[kv_namespaces]]
# binding = "DINOU_CACHE"
# id = "<YOUR_KV_NAMESPACE_ID>"
